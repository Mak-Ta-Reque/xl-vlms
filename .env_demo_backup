# ======================
# Crops Configuration
# ======================
# Minimum images required per tag
# Use 10 for dummy data at xl-vlms/data
# Use 20+ for full datasets


# Object detector for crops: 'none', 'langsam', 'sam3', or 'yolo_seg'
# - 'none': random crops only
# - 'langsam' or 'sam3': detector boxes + random crops to fill
# - 'yolo_seg': YOLOv11 instance segmentation (tag-free, detects all objects)
# sam3 requires HF_TOKEN with access to facebook/sam3
export OBJECT_DETECTOR="sam3"
# Positive/Negative binary segmentation mode:
#   1 = binary fg/bg masks per image (concept mask + inverted background), MASKS_PER_IMAGE forced to 2
#   0 = multi-mask pipeline (concept + auto masks, up to MASKS_PER_IMAGE)
export POSITIVE_NEGATIVE_SEGMENT=1
# Background masking method applied outside the segment mask:
#   'gaussian_blur' = Gaussian blur (original behaviour)
#   'ns'            = Navier-Stokes inpainting  (cv2.INPAINT_NS)
#   'telea'         = Telea inpainting           (cv2.INPAINT_TELEA)
#   'noisy_linear'  = Sparse linear interpolation (Rong et al. / ROAD)
#   'blackout'      = zero-out (black background)
# FG (concept) masking — sharp object, background replaced
export INPAINTING_METHOD="telea"
export MASK_BLUR_RADIUS=10
# BG (background) masking — sharp background, object replaced (tight crop)
export INPAINTING_METHOD_BG="telea"
export MASK_BLUR_RADIUS_BG=30
# Crop context: extra pixels kept around the mask bbox for spatial context
export MASK_CONTEXT_PIXELS=0
# Mask boundary dilation: applied once at segmentation time (crops_to_json.py).
# Dilates the FG mask by N pixels before inversion — the BG mask auto-erodes
# by the same amount.  Single variable controls both perspectives.
export MASK_BOUNDARY_PIXELS=50
export DETECTION_BATCH_SIZE=1
export OPEN_AI_API_KEY=""
# Debug: save VLM input images (blurred full + final crop) to OUTPUT_DIR/debug_vlm_inputs/
# Set to 1 to enable, 0 to disable (default: 0)
export DEBUG_SAVE_VLM_INPUTS=0

export BATCH_SIZE=10 # VLM batch size

