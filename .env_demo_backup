# Device configuration for model placement.
# Supported formats:
#   "cuda:1"       - GPU 1 only, CPU overflow if needed
#   "cuda:0,2"     - GPUs 0 and 2, CPU overflow
#   "cuda:[0,2]"   - same as above (bracket syntax)
#   "auto"         - all available GPUs, CPU overflow
#   "cpu"          - CPU only
export DEVICE="cuda:1"
export CLASSIFY_API_PORT=8501
export FRONTEND_PORT=5173

# Classify API upload downsampling (prevents CUDA OOM on very large images)
# Final ratio is min(CLASSIFY_API_DOWNSAMPLE_RATIO, CLASSIFY_API_MAX_LONG_EDGE / original_long_edge).
# Set ratio to 1.0 to disable fixed-ratio shrinking.
export CLASSIFY_API_DOWNSAMPLE_RATIO=1.0
# Hard cap for the uploaded image longest side (pixels) before inference.
export CLASSIFY_API_MAX_LONG_EDGE=512
# Bounding-box coordinate space returned by /api/ground: processed|original
# Use processed for fail-safe frontend sync when showing backend image.
export GROUND_BBOX_COORD_SPACE=processed