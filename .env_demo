# XL-VLMs Pipeline Configuration
# This file is sourced automatically by run_full_pipeline_without_coroping.sh
# NOTE: $ROOT_DIR and $SCRIPT_DIR are available here (defined before sourcing)

# ======================
# Data & Output Paths
# ======================
# Input dataset - absolute path (on different mount point)
export INPUT_DIR="/mnt/abka03/xlvlm_data/imagenet_3_class/train"

# Output directory - use $ROOT_DIR (inside project)
export OUTPUT_DIR="/mnt/abka03/Projects/xl-vlm-api/xl-vlms/outputs/imagenet_3_class_v2"

# Hugging Face model cache - absolute path (different user directory)
export HF_HOME="/mnt/abka03/huggingface/hub"
export HF_TOKEN=""
# Image root for grids (used by explainer) - use $ROOT_DIR (inside project)
export IMAGE_ROOT="/mnt/abka03/xlvlm_data/imagenet_5_class/val_grids"
export PROMPT="Identify all visible objects, items, entities, materials, textures, colors, shapes, symbols, text, scenes, actions, and visual patterns present in the image at the most detailed and fine-grained level possible. Include every distinguishable element or concept, even small or background details. Output only a strict, single-word, comma-separated list with no sentences, no explanations, and no extra text."
# ======================
# Crops Configuration
# ======================
# Minimum images required per tag
# Use 10 for dummy data at xl-vlms/data
# Use 20+ for full datasets


# Object detector for crops: 'none', 'langsam', 'sam3', or 'yolo_seg'
# - 'none': random crops only
# - 'langsam' or 'sam3': detector boxes + random crops to fill
# - 'yolo_seg': YOLOv11 instance segmentation (tag-free, detects all objects)
# sam3 requires HF_TOKEN with access to facebook/sam3
export OBJECT_DETECTOR="sam3"
export DETECTION_BATCH_SIZE=1
# Gaussian blur radius for background outside segmentation masks (0 = no blur)
export MASK_BLUR_RADIUS=30
# Context pixels beyond the segmentation mask boundary (spatial context for VLM)
export MASK_CONTEXT_PIXELS=20

# Debug: save VLM input images (blurred full + final crop) to OUTPUT_DIR/debug_vlm_inputs/
# Set to 1 to enable, 0 to disable (default: 0)
export DEBUG_SAVE_VLM_INPUTS=0

export BATCH_SIZE=10 # VLM batch size

# ======================
# Configuration Examples
# ======================
# Set to -1 to process ALL images from each category (no limit)
# export IMAGE_BUDGET=-1

# Dataset size per concept (-1 = unlimited, allows all crops)
# export DATASET_SIZE=-1

# Batch size for feature generation
# export BATCH_SIZE=16

# Minimal crops and patches
export MASKS_PER_IMAGE=5
export CONCEPT_MASKS_PER_IMAGE=1
export MAX_IMAGES_PER_TAG=10 # for selecting images for a concept this max image considered , if there more image for one concept tag we just chose max_images_per_tag images randomly
export MIN_IMAGES_PER_TAG=5 # if there is less than min_images_per_tag images for a concept tag we skip that concept
export BAG_SIZE=20
# Maximum number of segmentation masks (including the concept/positive mask) per image.
# Set to 0 for unlimited masks. Concept mask is always kept if present.
# =====================1
# Optional: Override other parameters
# ======================
# Uncomment and modify as needed:
export VLM_MODEL="Qwen/Qwen2.5-VL-3B-Instruct"
export LAYER_PATH="model.language_model.norm"
# export BATCH_SIZE=48
export SEED=42
export DEVICE_ID=0
export DECOMP_METHODS="snmf"
export PROMPT_TEMPLATE="yn"
export PATCH_SIZE=200
# Use IMAGE_SIZE_WIDTH as reference to resize image during inference and cropping concepts
export IMAGE_SIZE_WIDTH=512
#export MAX_IMAGES_PER_TAG=128
# export PATCHES_PER_IMAGE=24
